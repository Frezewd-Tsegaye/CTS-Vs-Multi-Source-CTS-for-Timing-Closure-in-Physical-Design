module SNPS_CLOCK_GATE_LOW_SDRAM_IF ( CLK, EN, ENCLK, TE );
  input CLK, EN, TE;
  output ENCLK;


  CGLNPRX2_LVT latch ( .CLK(CLK), .EN(1'b1), .SE(1'b0), .GCLK(ENCLK) );
endmodule


module SNPS_CLOCK_GATE_HIGH_SDRAM_IF ( CLK, EN, ENCLK, TE );
  input CLK, EN, TE;
  output ENCLK;


  CGLPPRX2_LVT latch ( .CLK(CLK), .EN(1'b1), .SE(1'b0), .GCLK(ENCLK) );
endmodule


