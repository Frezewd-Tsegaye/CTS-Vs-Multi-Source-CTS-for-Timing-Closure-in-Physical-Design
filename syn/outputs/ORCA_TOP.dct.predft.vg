module CLOCKING ( pclk_in, sdram_clk_in, sys_2x_clk_in, prst_n, test_mode, 
        shutdown, pclk, sdram_clk, sys_clk, sys_2x_clk, pci_rst_n, sdram_rst_n, 
        sys_rst_n, sys_2x_rst_n, sys_clk_cts_2, sys_2x_clk_cts_2, 
        sdram_clk_cts_2, pclk_cts_2 );
  input pclk_in, sdram_clk_in, sys_2x_clk_in, prst_n, test_mode, shutdown;
  output pclk, sdram_clk, sys_clk, sys_2x_clk, pci_rst_n, sdram_rst_n,
         sys_rst_n, sys_2x_rst_n, sys_clk_cts_2, sys_2x_clk_cts_2,
         sdram_clk_cts_2, pclk_cts_2;
  wire   pclk_in, sys_2x_clk_in, n1, sys_2x_rst_ff, pci_rst_n_buf,
         sdram_rst_n_buf, sys_2x_rst_n_buf, sdram_rst_ff, sys_rst_n_buf,
         sys_rst_ff, prst_ff, sys_clk_qn_d, sys_clk_in, n10, n15;
  assign pclk = pclk_in;
  assign sys_2x_clk = sys_2x_clk_in;

  TIEH_HVT icc_clock3 ( .Y(n1) );
  DFFARX1_RVT sys_2x_rst_n_buf_reg ( .D(sys_2x_rst_ff), .CLK(sys_2x_clk_in), 
        .RSTB(n15), .Q(sys_2x_rst_n_buf) );
  DFFARX1_RVT sdram_rst_n_buf_reg ( .D(sdram_rst_ff), .CLK(sdram_clk_in), 
        .RSTB(n15), .Q(sdram_rst_n_buf) );
  DFFARX1_RVT sys_rst_n_buf_reg ( .D(sys_rst_ff), .CLK(sys_clk_in), .RSTB(n15), 
        .Q(sys_rst_n_buf) );
  DFFARX1_RVT pci_rst_n_buf_reg ( .D(prst_ff), .CLK(pclk_in), .RSTB(n15), .Q(
        pci_rst_n_buf) );
  SDFFARX1_RVT prst_ff_reg ( .D(n1), .SI(1'b0), .SE(1'b0), .CLK(pclk_in), 
        .RSTB(n15), .Q(prst_ff) );
  SDFFARX1_RVT sys_rst_ff_reg ( .D(n1), .SI(1'b0), .SE(1'b0), .CLK(sys_clk_in), 
        .RSTB(n15), .Q(sys_rst_ff) );
  SDFFARX1_RVT sdram_rst_ff_reg ( .D(n1), .SI(1'b0), .SE(1'b0), .CLK(
        sdram_clk_in), .RSTB(n15), .Q(sdram_rst_ff) );
  SDFFARX1_RVT sys_2x_rst_ff_reg ( .D(n1), .SI(1'b0), .SE(1'b0), .CLK(
        sys_2x_clk_in), .RSTB(n15), .Q(sys_2x_rst_ff) );
